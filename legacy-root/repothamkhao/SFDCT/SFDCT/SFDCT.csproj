    </Reference>
    <Reference Include="SFD.PlayNAudioTest">
      <HintPath>..\Superfighters Deluxe\SFD.PlayNAudioTest.dll</HintPath>
    </Reference>
    <Reference Include="SFD.ScriptEngine">
      <HintPath>..\Superfighters Deluxe\SFD.ScriptEngine.dll</HintPath>
    </Reference>
    <Reference Include="SFD.WindowsFormsControlLibrary">
      <HintPath>..\Superfighters Deluxe\SFD.WindowsFormsControlLibrary.dll</HintPath>
